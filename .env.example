# Copy to .env.local and fill in. All optional.
# Google Drive sync: a Web OAuth client id (plan/steps/50-google-drive.md, "Human setup").
PUBLIC_GOOGLE_CLIENT_ID=
# Live sharing uses public Nostr relays by default. To use only your own Trystero relay instead
# (`pnpm relay` locally, or a private network), list it here.
# PUBLIC_LIVE_RELAY_URLS=ws://localhost:4444
