# Copy to .env.local and fill in. Both are optional: without them the features are hidden.
# Google Drive sync: a Web OAuth client id (plan/steps/50-google-drive.md, "Human setup").
PUBLIC_GOOGLE_CLIENT_ID=
# Live sharing relays, comma-separated (relay/README.md). Locally: `pnpm relay`.
PUBLIC_SIGNALING_URLS=ws://localhost:4444
